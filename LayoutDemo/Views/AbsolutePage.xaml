<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LayoutDemo.AbsolutePage"
             Title="AbsolutePage">
    <ScrollView>
        <VerticalStackLayout>
            <Label Text="This is a AbsoluteLayout"
               FontSize="24"
               HorizontalOptions="Center"
               Margin="0,20,0,20"/>
            <AbsoluteLayout>
        
                <BoxView Color="LightPink"
                    WidthRequest="100"
                    HeightRequest="100"
                    AbsoluteLayout.LayoutBounds="0.1, 0.1, AutoSize, AutoSize"
                    AbsoluteLayout.LayoutFlags="PositionProportional"/>
        
                <BoxView Color="LightGreen"
                    WidthRequest="100"
                    HeightRequest="100"
                    AbsoluteLayout.LayoutBounds="0.5, 0.5, AutoSize, AutoSize"
                    AbsoluteLayout.LayoutFlags="PositionProportional"/>

                <BoxView Color="LightBlue"
                    WidthRequest="100"
                    HeightRequest="100"
                    AbsoluteLayout.LayoutBounds="0.9, 0.9, AutoSize, AutoSize"
                    AbsoluteLayout.LayoutFlags="PositionProportional"/>

            </AbsoluteLayout>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>