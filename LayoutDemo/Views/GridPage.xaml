<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="LayoutDemo.GridPage"
             Title="GridPage">

        <Grid RowDefinitions="*,*" ColumnDefinitions="*,*">
            <BoxView Color="LightCoral" Grid.Row="0" Grid.Column="0"/>
            <BoxView Color="LightSeaGreen" Grid.Row="0" Grid.Column="1"/>
            <BoxView Color="LightSkyBlue" Grid.Row="1" Grid.Column="0"/>
            <BoxView Color="LightGoldenrodYellow" Grid.Row="1" Grid.Column="1"/>
        </Grid>

</ContentPage>